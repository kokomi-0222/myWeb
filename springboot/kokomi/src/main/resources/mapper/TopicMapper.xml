<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.kokomi.mapper.TopicMapper">

    <select id="selectAll" resultType="com.example.kokomi.entity.Topic">
        SELECT id, name, `value`, color, sort, created_at
        FROM topic
        ORDER BY sort ASC, id ASC
    </select>

    <select id="selectByValue" resultType="com.example.kokomi.entity.Topic">
        SELECT id, name, `value`, color, sort, created_at
        FROM topic
        WHERE `value` = #{value}
    </select>

    <select id="selectById" resultType="com.example.kokomi.entity.Topic">
        SELECT id, name, `value`, color, sort, created_at
        FROM topic
        WHERE id = #{id}
    </select>

    <!-- 帖子里实际出现过的话题及帖子数。
         话题表是「人工登记」的，历史上可能有人在 type 里写过别的值，
         这份统计用来把它们补进话题栏，避免老帖子没有入口。 -->
    <select id="countPostByType" resultType="com.example.kokomi.vo.TopicVO">
        SELECT `type` AS `value`, COUNT(*) AS `count`
        FROM post
        WHERE `type` IS NOT NULL AND `type` &lt;&gt; ''
        GROUP BY `type`
    </select>

    <select id="countPostsByValue" resultType="java.lang.Long">
        SELECT COUNT(*) FROM post WHERE `type` = #{value}
    </select>

    <select id="selectMaxSort" resultType="java.lang.Integer">
        SELECT IFNULL(MAX(sort), 0) FROM topic
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO topic (name, `value`, color, sort)
        VALUES (#{name}, #{value}, #{color}, #{sort})
    </insert>

    <update id="update">
        UPDATE topic
        <set>
            <if test="name != null and name != ''">`name` = #{name},</if>
            <if test="value != null and value != ''">`value` = #{value},</if>
            <if test="color != null and color != ''">`color` = #{color},</if>
            <if test="sort != null">`sort` = #{sort},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM topic WHERE id = #{id}
    </delete>

</mapper>
